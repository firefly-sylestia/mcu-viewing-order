# Optional: OMDb API key for ratings/plot metadata
VITE_OMDB_API_KEY=

# Fallback only (client-visible): use only if you cannot deploy the server proxy
VITE_TMDB_API_KEY=

# Server-side only (do NOT prefix with VITE_)
# Configure this in your hosting platform env vars for /api/tmdb/poster
TMDB_READ_ACCESS_TOKEN=

# Firebase Configuration — get these from your Firebase project console
# Go to Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

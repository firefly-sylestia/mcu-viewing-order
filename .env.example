# Environment variables — copy this file to .env and fill in your values

# Optional: OMDb API key for ratings/plot metadata
VITE_OMDB_API_KEY=

# Fallback only (client-visible): use only if you cannot deploy the server proxy
VITE_TMDB_API_KEY=

# Server-side only (do NOT prefix with VITE_)
# Configure this in your hosting platform env vars for /api/tmdb/poster
TMDB_READ_ACCESS_TOKEN=

# Kinocheck API — fetches official trailers for movies/shows
# Get your key at https://api.kinocheck.com/ (free tier: 1000 req/day without key)
# Server-side only (do NOT prefix with VITE_)
KINOCHECK_API_KEY=

# Supabase (client-safe values only; never add a service-role key here)
# Project Settings → API → Project URL and anon/public (or publishable) key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
